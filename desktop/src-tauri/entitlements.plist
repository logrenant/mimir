<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- WKWebView needs JIT and executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- The app spawns mimir-daemon as a sidecar; under hardened runtime the
       parent must be allowed to load a nested Mach-O it did not itself build.
       The sidecar is signed with the same identity at bundle time, so this is
       the narrow "let a signed child run" allowance, not a blanket bypass. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- REST + WebSocket to 127.0.0.1, and the daemon binds a loopback listener. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
</dict>
</plist>
