{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GOAT",
  "version": "1.1.0",
  "identifier": "com.goat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GOAT",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "label": "main"
      },
      {
        "label": "quick",
        "title": "GOAT — New task",
        "url": "index.html",
        "width": 680,
        "height": 460,
        "center": true,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    },
    "trayIcon": {
      "id": "goat-tray",
      "iconPath": "icons/tray-Template.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/goat-daemon"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
