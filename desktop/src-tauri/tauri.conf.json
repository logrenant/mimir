{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimir",
  "version": "2.13.0",
  "identifier": "studio.mimir.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mimir",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560,
        "label": "main",
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "title": "Mimir",
        "url": "index.html",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; script-src 'self'"
    },
    "trayIcon": {
      "id": "mimir-tray",
      "iconPath": "icons/mimirTemplate.png",
      "iconAsTemplate": true,
      "showMenuOnLeftClick": false
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/mimir-daemon"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
